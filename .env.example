# Express API
EXPRESS_PORT=3001
# Next.js server → Express 프록시 (서버 사이드)
EXPRESS_API_URL=http://127.0.0.1:3001
# 브라우저 → Express 직접 호출 (클라이언트 사이드)
# EC2 단일 서버: http://127.0.0.1:3001 또는 공인 IP/도메인
# Nginx로 /api 를 Express에 프록시하면 빈 값 또는 동일 오리진 URL 사용
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# MySQL (EC2 내부 설치 시 127.0.0.1 고정)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kiosk
DB_PASSWORD=change_me
DB_NAME=senior_kiosk

# OpenAI (음성 주문 해석)
OPENAI_API_KEY=

# Google Cloud TTS (REST 직접 호출)
GOOGLE_TTS_API_KEY=
# 구버전 .env 호환 (위와 동일 키면 하나만 있어도 됨)
GOOGLE_API_KEY=
GOOGLE_TTS_LANGUAGE_CODE=ko-KR
GOOGLE_TTS_VOICE_NAME=ko-KR-Neural2-A
GOOGLE_TTS_SPEAKING_RATE=0.88
GOOGLE_TTS_PITCH=0
